---
import Page from '../../layouts/Page.astro';
import Photo from '../../components/Photo.astro';
import img0 from '../../assets/img/site/linga-2023-12.webp';
import img1 from '../../assets/img/site/alankara-2023-01.webp';
import img2 from '../../assets/img/site/ganapati-2023-01.webp';
import img3 from '../../assets/img/site/alankara-2023-12.webp';
import img4 from '../../assets/img/site/procession-2023-01.webp';
import img5 from '../../assets/img/site/pooja-2023-12.webp';
import img6 from '../../assets/img/site/masks-2023-12.webp';
import img7 from '../../assets/img/site/kola-2023-01.webp';
import img8 from '../../assets/img/site/kola-2023-12-a.webp';
import img9 from '../../assets/img/site/kola-2023-12-b.webp';
import img10 from '../../assets/img/site/kola-2023-12-c.webp';
import img11 from '../../assets/img/site/old-orig.webp';
import img12 from '../../assets/img/site/old-orig2.webp';
import img13 from '../../assets/img/site/old-orig1.webp';
import img14 from '../../assets/img/site/old-orig3.webp';
import img15 from '../../assets/img/site/old-route.webp';
import img16 from '../../assets/img/site/old-cave.webp';
import img17 from '../../assets/img/site/old-hist.webp';
import img18 from '../../assets/img/site/old-fest.webp';
import img19 from '../../assets/img/site/old-seva.webp';
import img20 from '../../assets/img/site/old-desc1.webp';
import img21 from '../../assets/img/site/old-main.webp';
---
<Page article title={"Gallery"} description={"Photographs of Sri Somanatheshwara Guhalaya, Nellitheertha."} slug={"gallery"} eyebrow={"PHOTOGRAPHS"} back={{"href": "/#pages", "label": "Home"}} next={{"href": "/visit/", "label": "How to reach"}}>
        <h2 id="2023">From the temple, 2023</h2>
        <div class="gallery">
          <figure><Photo src={img0} alt={"A dark stone Linga in a golden frame, lamps burning above it"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>The Linga in the sanctum, December 2023</figcaption></figure>
          <figure><Photo src={img1} alt={"The deity with a silver face, in garlands of red, white and green, a lamp burning in front"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Alankara, January 2023</figcaption></figure>
          <figure><Photo src={img2} alt={"Ganapati decorated with garlands of red, yellow and white flowers"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Mahaganapati, January 2023</figcaption></figure>
          <figure><Photo src={img3} alt={"Two decorated deities with silver faces, covered in garlands"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Alankara, December 2023</figcaption></figure>
          <figure><Photo src={img4} alt={"Devotees carrying the decorated deity in a procession"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Procession, January 2023</figcaption></figure>
          <figure><Photo src={img5} alt={"A priest performing a pooja in a small decorated mantapa at night"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Pooja, December 2023</figcaption></figure>
          <figure><Photo src={img6} alt={"Two masks, one silver and one brass, on a white cloth with flowers and lamps"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>December 2023</figcaption></figure>
          <figure><Photo src={img7} alt={"A bhoota in a yellow mask and a tall silver crown, holding a sword"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Bhoota Kola, January 2023</figcaption></figure>
          <figure><Photo src={img8} alt={"A bhoota with a yellow painted face and a red and gold costume"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Bhoota Kola, December 2023</figcaption></figure>
          <figure><Photo src={img9} alt={"A bhoota with a large round frame of palm leaves behind it"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Bhoota Kola, December 2023</figcaption></figure>
          <figure><Photo src={img10} alt={"A bhoota at night among garlands and lamps"} sizes="(min-width: 700px) 40vw, 100vw" /><figcaption>Bhoota Kola, December 2023</figcaption></figure>
        </div>
        <h2 id="earlier">From the earlier website</h2>
        <p class="note">These photographs were on the first nellitheertha.com website. Some are marked © K.B. Mallya.</p>
        <div class="old-gallery">
          <figure><Photo src={img11} alt={"A pond with clear blue water and laterite edges"} sizes="350px" /></figure>
          <figure><Photo src={img12} alt={"The entrance arch of the temple, with its name"} sizes="350px" /></figure>
          <figure><Photo src={img13} alt={"A white shrine in an enclosed garden"} sizes="350px" /></figure>
          <figure><Photo src={img14} alt={"A small shrine beneath a tree"} sizes="350px" /></figure>
          <figure><Photo src={img15} alt={"Steps through the forest"} sizes="350px" /></figure>
          <figure><Photo src={img16} alt={"The rock inside the cave"} sizes="350px" /></figure>
          <figure><Photo src={img17} alt={"A Linga with lamps, inside the cave"} sizes="350px" /></figure>
          <figure><Photo src={img18} alt={"A priest carrying the decorated deity on his head"} sizes="350px" /></figure>
          <figure><Photo src={img19} alt={"Priests at a seva before the deity"} sizes="350px" /></figure>
          <figure><Photo src={img20} alt={"The deity, decorated with garlands"} sizes="350px" /></figure>
          <figure><Photo src={img21} alt={"A collage of the temple, its deities and its arch"} sizes="350px" /></figure>
        </div>
</Page>

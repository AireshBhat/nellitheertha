        <div class="old-gallery">
          <figure><img src="/assets/img/site/old-orig.webp" alt="A pond with clear blue water and laterite edges" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-orig2.webp" alt="The entrance arch of the temple, with its name" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-orig1.webp" alt="A white shrine in an enclosed garden" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-orig3.webp" alt="A small shrine beneath a tree" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-route.webp" alt="Steps through the forest" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-cave.webp" alt="The rock inside the cave" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-hist.webp" alt="A Linga with lamps, inside the cave" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-fest.webp" alt="A priest carrying the decorated deity on his head" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-seva.webp" alt="Priests at a seva before the deity" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-desc1.webp" alt="The deity, decorated with garlands" loading="lazy"></figure>
          <figure><img src="/assets/img/site/old-main.webp" alt="A collage of the temple, its deities and its arch" loading="lazy"></figure>
        </div>
</Page>

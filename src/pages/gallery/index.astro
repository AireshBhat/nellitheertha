---
import Page from '../../layouts/Page.astro';
---
<Page article title={"Gallery"} description={"Photographs of Sri Somanatheshwara Guhalaya, Nellitheertha."} slug={"gallery"} eyebrow={"PHOTOGRAPHS"} back={{"href": "/#pages", "label": "Home"}} next={{"href": "/visit/", "label": "How to reach"}}>
        <h2 id="2023">From the temple, 2023</h2>
        <div class="gallery">
          <figure><img src="/assets/img/site/linga-2023-12-sm.webp" srcset="/assets/img/site/linga-2023-12-sm.webp 720w, /assets/img/site/linga-2023-12.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A dark stone Linga in a golden frame, lamps burning above it" loading="lazy"><figcaption>The Linga in the sanctum, December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/alankara-2023-01-sm.webp" srcset="/assets/img/site/alankara-2023-01-sm.webp 720w, /assets/img/site/alankara-2023-01.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="The deity with a silver face, in garlands of red, white and green, a lamp burning in front" loading="lazy"><figcaption>Alankara, January 2023</figcaption></figure>
          <figure><img src="/assets/img/site/ganapati-2023-01-sm.webp" srcset="/assets/img/site/ganapati-2023-01-sm.webp 720w, /assets/img/site/ganapati-2023-01.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="Ganapati decorated with garlands of red, yellow and white flowers" loading="lazy"><figcaption>Mahaganapati, January 2023</figcaption></figure>
          <figure><img src="/assets/img/site/alankara-2023-12-sm.webp" srcset="/assets/img/site/alankara-2023-12-sm.webp 720w, /assets/img/site/alankara-2023-12.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="Two decorated deities with silver faces, covered in garlands" loading="lazy"><figcaption>Alankara, December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/procession-2023-01-sm.webp" srcset="/assets/img/site/procession-2023-01-sm.webp 720w, /assets/img/site/procession-2023-01.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="Devotees carrying the decorated deity in a procession" loading="lazy"><figcaption>Procession, January 2023</figcaption></figure>
          <figure><img src="/assets/img/site/pooja-2023-12-sm.webp" srcset="/assets/img/site/pooja-2023-12-sm.webp 720w, /assets/img/site/pooja-2023-12.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A priest performing a pooja in a small decorated mantapa at night" loading="lazy"><figcaption>Pooja, December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/masks-2023-12-sm.webp" srcset="/assets/img/site/masks-2023-12-sm.webp 720w, /assets/img/site/masks-2023-12.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="Two masks, one silver and one brass, on a white cloth with flowers and lamps" loading="lazy"><figcaption>December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/kola-2023-01-sm.webp" srcset="/assets/img/site/kola-2023-01-sm.webp 720w, /assets/img/site/kola-2023-01.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A bhoota in a yellow mask and a tall silver crown, holding a sword" loading="lazy"><figcaption>Bhoota Kola, January 2023</figcaption></figure>
          <figure><img src="/assets/img/site/kola-2023-12-a-sm.webp" srcset="/assets/img/site/kola-2023-12-a-sm.webp 720w, /assets/img/site/kola-2023-12-a.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A bhoota with a yellow painted face and a red and gold costume" loading="lazy"><figcaption>Bhoota Kola, December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/kola-2023-12-b-sm.webp" srcset="/assets/img/site/kola-2023-12-b-sm.webp 720w, /assets/img/site/kola-2023-12-b.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A bhoota with a large round frame of palm leaves behind it" loading="lazy"><figcaption>Bhoota Kola, December 2023</figcaption></figure>
          <figure><img src="/assets/img/site/kola-2023-12-c-sm.webp" srcset="/assets/img/site/kola-2023-12-c-sm.webp 720w, /assets/img/site/kola-2023-12-c.webp 1600w" sizes="(min-width: 700px) 40vw, 100vw" alt="A bhoota at night among garlands and lamps" loading="lazy"><figcaption>Bhoota Kola, December 2023</figcaption></figure>
        </div>
        <h2 id="earlier">From the earlier website</h2>

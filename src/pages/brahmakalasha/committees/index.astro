---
import { getEntry } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import Both from '../../../components/Both.astro';
const data = (await getEntry('committees', 'committees'))!.data;
const groups = data.groups;
const inv = (await getEntry('invitation', 'invitation'))!.data;
// The patrike's own Kannada lists, in its own groups and order (pages 9 to 12). In ಕನ್ನಡ they replace the English ones.
const kn = data.kn;
const en = (cls: string) => (kn ? `${cls} en-only` : cls);
// A parent heading (h2) appears once, unless a group of that name already appeared; groups under a parent are h3.
const shown = new Set<string>();
const blocks = groups.map((g) => {
  const parent = g.parent && !shown.has(g.parent) ? g.parent : null;
  if (g.parent) shown.add(g.parent);
  shown.add(g.title);
  return { parent, level: g.parent ? 'h3' : 'h2', group: g };
});
const sub = (m: { role?: string | null; place?: string | null }) => [m.role, m.place].filter(Boolean).join(', ');
// The patrike's band heading appears once, over the committees printed under it (h3), as the English parents do.
const knShown = new Set<string>();
const knBlocks = (kn?.groups ?? []).map((g) => {
  const parent = g.parent && !knShown.has(g.parent) ? g.parent : null;
  if (g.parent) knShown.add(g.parent);
  knShown.add(g.title);
  return { parent, level: g.parent ? 'h3' : 'h2', group: g };
});
---
<Page article slug="brahmakalasha/committees" eyebrow="BRAHMAKALASHA 2026" title="Committees and supporters"
  description="The committees, Mahadanis and supporters of the Brahmakalasha at Sri Kshetra Nellitheertha."
  back={{ href: '/brahmakalasha/', label: 'Brahmakalasha 2026' }} next={{ href: '/brahmakalasha/', label: 'Brahmakalasha 2026' }}>
  {blocks.map(({ parent, level, group }) => (
    <>
      {parent && <h2 class={kn ? 'en-only' : undefined}>{parent}</h2>}
      {level === 'h3' ? <h3 class={kn ? 'en-only' : undefined}>{group.title}</h3> : <h2 class={kn ? 'en-only' : undefined}>{group.title}</h2>}
      <ul class={en('names')}>
        {group.members.map((m) => <li>{m.name}{sub(m) && <small>{sub(m)}</small>}</li>)}
      </ul>
    </>
  ))}
  {knBlocks.map(({ parent, level, group }) => (
    <>
      {parent && <h2 class="kn-only" lang="kn">{parent}</h2>}
      {level === 'h3' ? <h3 class="kn-only" lang="kn">{group.title}</h3> : <h2 class="kn-only" lang="kn">{group.title}</h2>}
      <ul class="names kn-only" lang="kn">
        {group.members.map((m) => <li>{m.name}{sub(m) && <small>{sub(m)}</small>}</li>)}
      </ul>
    </>
  ))}
  <h2 id="mahadanis"><Both en="Mahadanis who contributed to the Jeernoddhara" kn={kn?.mahadanis_heading} /></h2>
  <ul class={en('names')}>
    {inv.mahadanis.map((m) => <li>{m.name}{m.detail && <small>{m.detail}</small>}</li>)}
  </ul>
  {kn && (
    <ul class="names kn-only" lang="kn">
      {kn.mahadanis.map((m) => <li>{m.name}{sub(m) && <small>{sub(m)}</small>}</li>)}
    </ul>
  )}
  <h2 id="supporters"><Both en="Dignitaries and organisations who extended support" kn={kn?.supporters_heading} /></h2>
  <ul class={en('names')}>
    {inv.supporters.map((m) => <li>{m.name}{m.detail && <small>{m.detail}</small>}</li>)}
  </ul>
  {kn && (
    <ul class="names kn-only" lang="kn">
      {kn.supporters.map((m) => <li>{m.name}{sub(m) && <small>{sub(m)}</small>}</li>)}
    </ul>
  )}
</Page>

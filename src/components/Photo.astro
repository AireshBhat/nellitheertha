---
// A photograph as AVIF and WebP at several widths, so a phone downloads a phone-sized file.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; sizes: string; widths?: number[]; loading?: 'lazy' | 'eager'; class?: string; quality?: number }
// Quality 42 (sharp's AVIF default is 50): about a fifth lighter, no visible loss at phone sizes (checked 2026-11-09).
const { src, alt, sizes, widths = [400, 720, 1080, 1600], loading = 'lazy', class: className, quality = 42 } = Astro.props;
const usable = widths.filter((w) => w < src.width);
usable.push(src.width);
---
<Picture src={src} alt={alt} widths={usable} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" quality={quality} loading={loading} decoding="async" class={className} />

---
import type { CollectionEntry } from 'astro:content';
import Both from './Both.astro';
import { UPI } from '../lib/brahmakalasha';
type Inv = CollectionEntry<'invitation'>['data'];
interface Props { bank: Inv['bank']; kn?: NonNullable<Inv['kn']>['bank'] }
const { bank: b, kn } = Astro.props;
const lines = [b.account_name, [b.bank, b.branch].filter(Boolean).join(', ')].filter(Boolean) as string[];
if (b.account_type) lines.push(`Account type: ${b.account_type}`);
lines.push(`Account number: ${b.account_number}`, `IFSC: ${b.ifsc}`);
if (b.upi_id) lines.push(`UPI: ${b.upi_id}`);
const knLines = kn ? [...kn.lines, `IFSC: ${b.ifsc}`, ...(b.upi_id ? [`UPI: ${b.upi_id}`] : [])] : [];
---
<h2 id="contribute"><Both en="Contribute" kn={kn?.heading} /></h2>
{b.intro && <p><Both en={b.intro} kn={kn?.intro} /></p>}
<div class="bank">
  <p class={kn ? 'en-only' : undefined}>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
  {kn && <p class="kn-only" lang="kn">{knLines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>}
  <img class="qr" src="/assets/img/upi-qr.png" alt="UPI QR code for the Sri Somanatheshwara Temple Jeernodhara Samithi account" width="863" height="867" loading="lazy">
  <p><a class="action primary" href={UPI}>Pay with a UPI app</a></p>
</div>
{b.contact_line && <p><Both en={b.contact_line} kn={kn?.contact_line} /></p>}

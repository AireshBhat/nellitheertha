---
import type { CollectionEntry } from 'astro:content';
import Both from './Both.astro';
import { posters, type Group } from '../lib/brahmakalasha';
interface Props { group: Group<CollectionEntry<'programme'>['data']> }
const { group } = Astro.props;
const files = posters(group.day);
const id = `dec-${group.day}`;
const knDay = group.blocks.find((b) => b.kn)?.kn;
const only = (has: unknown, cls: string) => (has ? `${cls} en-only` : cls);
---
<section class="day" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}><Both en={`${group.weekday}, ${group.day} December`} kn={knDay?.heading} /></h2>
  {group.blocks.map((block) => (
    <>
      {block.heading && <p class="day-heading">{block.heading}</p>}
      {block.sections.map((sec) => (
        <>
          <h3><Both en={sec.name} kn={sec.kn?.name} /></h3>
          <ol class={only(sec.kn, 'prog')}>
            {sec.items.map((it) => (
              <li><span class="t">{it.time}</span><span class="x">{it.text}{(it.details ?? []).filter(Boolean).map((d) => <span class="d">{d}</span>)}</span></li>
            ))}
          </ol>
          {sec.kn && (
            <ol class="prog kn-only" lang="kn">
              {sec.kn.items.map((it) => (
                <li><span class="t">{it.time}</span><span class="x">{it.text}{it.details.map((d) => <span class="d">{d}</span>)}</span></li>
              ))}
            </ol>
          )}
        </>
      ))}
      {(block.notes ?? []).map((note) => <p class={only(block.kn?.notes?.length, 'note')}>{note}</p>)}
      {(block.kn?.notes ?? []).map((note) => <p class="note kn-only" lang="kn">{note}</p>)}
    </>
  ))}
  <p class="poster-links">{files.map((f, i) => <>{i > 0 && ' '}<a href={`/assets/posters/${f}`}>Poster{files.length > 1 ? ` ${i + 1}` : ''}</a></>)}</p>
</section>

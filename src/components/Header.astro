---
import LanguageSwitch from './LanguageSwitch.astro';
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
{home ? <a class="skip" href="#programme">Skip to the Brahmakalasha</a> : <a class="skip" href="#content">Skip to content</a>}
<header class:list={['site-header', { 'home-header': home }]}>
  <a class="brand" href={home ? '#top' : '/'} aria-label="Nellitheertha home">
    <svg viewBox="0 0 18 24" aria-hidden="true"><path d="M9 1C9 1 2 11 2 16a7 7 0 0 0 14 0C16 11 9 1 9 1Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    <span>Nellitheertha</span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="/brahmakalasha/">Brahmakalasha</a>
    <a href={home ? '#pages' : '/#pages'}>About</a>
    <a href={home ? '#visit' : '/visit/'}>Visit</a>
    <a href={home ? '#contribute' : '/#contribute'}>Contribute</a>
  </nav>
  <LanguageSwitch />
</header>
{home && (
  /* On the home page the header floats over the dark picture until you scroll past 20px, and again over the forest
     walk while its dark is behind the header: from 40% of a screen into the walk, where the light fade at its top has
     passed, until 75% of a screen before its end, where the fade back to the page begins (tests/header.mjs). It runs
     here, before the page is drawn, so the header never flashes; without it the header simply stays solid. */
  <script is:inline>(function () { var h = document.querySelector('.home-header'), forest; var set = function () { forest = forest || document.getElementById('forest'); var r = forest && forest.getBoundingClientRect(), dark = r && r.top <= -0.4 * innerHeight && r.bottom >= 0.75 * innerHeight; h.classList.toggle('solid', scrollY > 20 && !dark); }; set(); addEventListener('scroll', set, { passive: true }); addEventListener('DOMContentLoaded', set); })();</script>
)}

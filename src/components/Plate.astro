---
// A photograph within a page's text: "tall side" floats beside the text on wide screens, "wide" spans the column.
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; kind?: string }
const { src, alt, caption, kind = 'tall side' } = Astro.props;
const sizes = kind.includes('side') ? '(min-width: 1000px) 400px, 100vw' : '(min-width: 1160px) 1120px, 100vw';
---
<figure class={`plate ${kind}`}><Photo src={src} alt={alt} sizes={sizes} />{caption && <figcaption>{caption}</figcaption>}</figure>
